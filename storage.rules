rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(
            /databases/(default)/documents/usuarios/$(request.auth.uid)
          ).data.rol
        : '';
    }

    function isWarehouse() {
      return role() in ['admin', 'almacenista'];
    }

    function activeProfile() {
      return signedIn() && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('activo',true) != false;
    }
    function enterprisePermission(key) {
      return activeProfile() && (role() == 'admin'
        || firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('permisosEmpresa',[]).hasAny([key]));
    }
    function financeView() {
      return activeProfile() && (role() in ['admin','finanzas','contabilidad']
        || enterprisePermission('finanzas') || enterprisePermission('direccion'));
    }
    function financeUpload() {
      return activeProfile() && (role() in ['admin','finanzas','contabilidad']
        || enterprisePermission('finanzas') || enterprisePermission('solicitarCompras'));
    }

    match /finance/{userId}/{operationId}/{fileName} {
      allow read: if activeProfile() && (request.auth.uid == userId || financeView());
      allow create: if financeUpload() && request.auth.uid == userId
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf','application/xml','text/xml'];
      // Receipts/fiscal evidence remain immutable. Corrections are new files.
      allow update, delete: if false;
    }
    match /instalaciones/{orderId}/{allPaths=**} {
      allow read: if activeProfile() && (enterprisePermission('instalaciones')
        || firestore.get(/databases/(default)/documents/instalacion_ordenes/$(orderId)).data.participantes.hasAny([request.auth.uid]));
      allow write: if false;
    }

    // Contenido social, evidencias, perfiles y audios. La cantidad de archivos
    // no se limita, pero cada objeto pertenece al usuario que lo subió.
    match /media/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Compatibilidad temporal con módulos antiguos que aún usan rutas
    // históricas de Firebase Storage.
    match /justification_evidence/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || role() == 'admin');
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && (request.auth.uid == userId || role() == 'admin');
    }
    match /{legacyRoot}/{allPaths=**} {
      allow read: if signedIn() && !(legacyRoot in ['justification_evidence','finance','instalaciones']);
      allow create: if signedIn()
        && request.resource.size <= 50 * 1024 * 1024
        && ((legacyRoot in [
          'justificaciones',
          'recepciones_obra',
          'devoluciones'
        ]) || (isWarehouse() && legacyRoot in [
          'insumos_inventario',
          'recepciones_almacen',
          'saunas_imagenes'
        ]));
      allow update, delete: if isWarehouse()
        && legacyRoot in [
          'insumos_inventario',
          'justificaciones',
          'recepciones_almacen',
          'recepciones_obra',
          'devoluciones',
          'saunas_imagenes'
        ];
    }
  }
}
