rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function role() {
      return hasProfile() ? get(userPath()).data.rol : '';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isWarehouse() {
      return isAdmin() || role() == 'almacenista';
    }

    function toolPath(toolId) {
      return /databases/$(database)/documents/cajitas_inventario/$(toolId);
    }

    function transferPath(transferId) {
      return /databases/$(database)/documents/traspasos_inventario/$(transferId);
    }

    function startsOwnToolTransfer(toolId) {
      let transferId = request.resource.data.traspaso_pendiente_id;
      let transfer = getAfter(transferPath(transferId)).data;
      let originalOwner = resource.data.get('propietario_original_id', '');
      return signedIn()
        && resource.data.trabajador_actual_id == request.auth.uid
        && resource.data.estado == 'asignado'
        && request.resource.data.estado == 'en_transito'
        && transferId is string
        && transferId.size() > 0
        && request.resource.data.traspaso_destino_id is string
        && request.resource.data.traspaso_destino_id != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'traspaso_pendiente_id',
          'traspaso_destino_id'
        ])
        && transfer.herramienta_id == toolId
        && transfer.origen_usuario_id == request.auth.uid
        && transfer.destino_usuario_id == request.resource.data.traspaso_destino_id
        && transfer.estado == 'pendiente'
        && ((originalOwner == '' && transfer.tipo == 'prestamo')
          || (originalOwner != ''
            && transfer.tipo == 'devolucion'
            && transfer.destino_usuario_id == originalOwner));
    }

    function acceptsAssignedToolTransfer(toolId) {
      let transferId = resource.data.get(
        'traspaso_pendiente_id',
        request.resource.data.ultimo_traspaso_id
      );
      let transfer = getAfter(transferPath(transferId)).data;
      let originalOwner = resource.data.get('propietario_original_id', '');
      let isReturn = originalOwner != '' && originalOwner == request.auth.uid;
      return signedIn()
        && resource.data.estado == 'en_transito'
        && transfer.destino_usuario_id == request.auth.uid
        && request.resource.data.estado == 'asignado'
        && request.resource.data.trabajador_actual_id == request.auth.uid
        && request.resource.data.trabajador_actual_nombre == get(userPath()).data.nombre
        && !('traspaso_pendiente_id' in request.resource.data)
        && !('traspaso_destino_id' in request.resource.data)
        && request.resource.data.ultimo_traspaso_id == transferId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trabajador_actual_id',
          'trabajador_actual_nombre',
          'estado',
          'propietario_original_id',
          'propietario_original_nombre',
          'traspaso_pendiente_id',
          'traspaso_destino_id',
          'ultimo_traspaso_id'
        ])
        && transfer.herramienta_id == toolId
        && transfer.destino_usuario_id == request.auth.uid
        && transfer.estado == 'completado'
        && transfer.confirmado_por == request.auth.uid
        && (isReturn
          ? (!('propietario_original_id' in request.resource.data)
            && !('propietario_original_nombre' in request.resource.data))
          : (originalOwner == ''
            && request.resource.data.propietario_original_id == transfer.origen_usuario_id
            && request.resource.data.propietario_original_nombre == transfer.origen_usuario_nombre));
    }

    function rejectsAssignedToolTransfer(toolId) {
      let transferId = resource.data.get(
        'traspaso_pendiente_id',
        request.resource.data.ultimo_traspaso_id
      );
      let transfer = getAfter(transferPath(transferId)).data;
      return signedIn()
        && resource.data.estado == 'en_transito'
        && transfer.destino_usuario_id == request.auth.uid
        && request.resource.data.estado == 'asignado'
        && request.resource.data.trabajador_actual_id == resource.data.trabajador_actual_id
        && !('traspaso_pendiente_id' in request.resource.data)
        && !('traspaso_destino_id' in request.resource.data)
        && request.resource.data.ultimo_traspaso_id == transferId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'traspaso_pendiente_id',
          'traspaso_destino_id',
          'ultimo_traspaso_id'
        ])
        && transfer.herramienta_id == toolId
        && transfer.destino_usuario_id == request.auth.uid
        && transfer.estado == 'rechazado'
        && transfer.confirmado_por == request.auth.uid;
    }

    function isValidWorkerToolUpdate(toolId) {
      return signedIn()
        && (request.resource.data.get('estado', '') == 'en_transito'
          ? startsOwnToolTransfer(toolId)
          : ((resource.data.get('estado', '') == 'en_transito'
              && request.resource.data.get('estado', '') == 'asignado')
            ? (request.resource.data.get('trabajador_actual_id', '') == request.auth.uid
              ? acceptsAssignedToolTransfer(toolId)
              : rejectsAssignedToolTransfer(toolId))
            : false));
    }

    function createsValidToolTransfer(transferId) {
      let toolId = request.resource.data.herramienta_id;
      let tool = get(toolPath(toolId)).data;
      let updatedTool = getAfter(toolPath(toolId)).data;
      let originalOwner = tool.get('propietario_original_id', '');
      return signedIn()
        && request.resource.data.keys().hasAll([
          'herramienta_id',
          'nombre_herramienta',
          'origen_usuario_id',
          'origen_usuario_nombre',
          'destino_usuario_id',
          'destino_usuario_nombre',
          'participantes',
          'tipo',
          'estado',
          'fecha_creacion'
        ])
        && request.resource.data.keys().hasOnly([
          'herramienta_id',
          'nombre_herramienta',
          'origen_usuario_id',
          'origen_usuario_nombre',
          'destino_usuario_id',
          'destino_usuario_nombre',
          'participantes',
          'tipo',
          'estado',
          'fecha_creacion'
        ])
        && tool.trabajador_actual_id == request.auth.uid
        && tool.estado == 'asignado'
        && request.resource.data.nombre_herramienta == tool.nombre
        && request.resource.data.origen_usuario_id == request.auth.uid
        && request.resource.data.origen_usuario_nombre == get(userPath()).data.nombre
        && request.resource.data.destino_usuario_id is string
        && request.resource.data.destino_usuario_id != request.auth.uid
        && request.resource.data.destino_usuario_nombre ==
          get(/databases/$(database)/documents/usuarios/$(request.resource.data.destino_usuario_id)).data.nombre
        && request.resource.data.participantes == [
          request.auth.uid,
          request.resource.data.destino_usuario_id
        ]
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.fecha_creacion == request.time
        && updatedTool.estado == 'en_transito'
        && updatedTool.traspaso_pendiente_id == transferId
        && updatedTool.traspaso_destino_id == request.resource.data.destino_usuario_id
        && ((originalOwner == '' && request.resource.data.tipo == 'prestamo')
          || (originalOwner != ''
            && request.resource.data.tipo == 'devolucion'
            && request.resource.data.destino_usuario_id == originalOwner));
    }

    function resolvesOwnToolTransfer(transferId) {
      let toolId = resource.data.herramienta_id;
      let tool = get(toolPath(toolId)).data;
      let updatedTool = getAfter(toolPath(toolId)).data;
      let accepted = request.resource.data.get('estado', '') == 'completado';
      let expectedType = tool.get('propietario_original_id', '') == ''
        ? 'prestamo'
        : 'devolucion';
      return signedIn()
        && resource.data.estado == 'pendiente'
        && resource.data.destino_usuario_id == request.auth.uid
        && request.resource.data.confirmado_por == request.auth.uid
        && request.resource.data.participantes == [
          resource.data.origen_usuario_id,
          resource.data.destino_usuario_id
        ]
        && request.resource.data.tipo == expectedType
        && request.resource.data.estado in ['completado', 'rechazado']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          accepted
            ? [
                'estado',
                'fecha_aceptacion',
                'confirmado_por',
                'participantes',
                'tipo'
              ]
            : [
                'estado',
                'fecha_rechazo',
                'confirmado_por',
                'participantes',
                'tipo'
              ]
        )
        && (accepted
          ? (request.resource.data.estado == 'completado'
            && request.resource.data.fecha_aceptacion == request.time
            && updatedTool.estado == 'asignado'
            && updatedTool.trabajador_actual_id == request.auth.uid)
          : (request.resource.data.estado == 'rechazado'
            && request.resource.data.fecha_rechazo == request.time
            && updatedTool.estado == 'asignado'
            && updatedTool.trabajador_actual_id == resource.data.origen_usuario_id))
        && updatedTool.ultimo_traspaso_id == transferId
        && !('traspaso_pendiente_id' in updatedTool)
        && !('traspaso_destino_id' in updatedTool);
    }

    function isSafeOwnProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.get('intereses', '') is string
        && request.resource.data.get('intereses', '').size() <= 400
        && request.resource.data.get('coloresFavoritos', '') is string
        && request.resource.data.get('coloresFavoritos', '').size() <= 160
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'cumpleanos',
          'fotoUrl',
          'fotoRuta',
          'fcmTokens',
          'pushActualizadoEn',
          'pushPlataforma',
          'bio',
          'intereses',
          'coloresFavoritos',
          'redesSociales'
        ]);
    }

    function isSafeNotificationCreate() {
      return signedIn()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.destinatarioId != 'todos'
        && request.resource.data.rolesDestinatarios is list
        && request.resource.data.rolesDestinatarios.hasOnly([
          'admin',
          'almacenista'
        ]);
    }

    function isValidAttendanceCreate(attendanceId) {
      let data = request.resource.data;
      return signedIn()
        && attendanceId.matches(request.auth.uid + '_[0-9]{8}')
        && data.keys().hasAll([
          'id',
          'trabajadorId',
          'fecha',
          'estatus',
          'estatusComida',
          'ubicacionValida',
          'motivoFalta',
          'estatusJustificacion'
        ])
        && data.keys().hasOnly([
          'id',
          'trabajadorId',
          'fecha',
          'estatus',
          'estatusComida',
          'ubicacionValida',
          'motivoFalta',
          'evidenciaJustificacionUrl',
          'estatusJustificacion'
        ])
        && data.id == attendanceId
        && data.trabajadorId == request.auth.uid
        && data.fecha is timestamp
        && data.fecha >= request.time - duration.value(90, 'd')
        && data.fecha <= request.time + duration.value(1, 'd')
        && data.estatus == 'falta'
        && data.estatusComida == 'ninguna'
        && data.ubicacionValida == false
        && data.motivoFalta is string
        && data.motivoFalta.size() > 0
        && data.motivoFalta.size() <= 2000
        && data.get('evidenciaJustificacionUrl', '') is string
        && data.get('evidenciaJustificacionUrl', '').size() <= 4096
        && data.estatusJustificacion == 'pendiente_revision';
    }

    function submitsOwnJustification() {
      return resource.data.get('estatusJustificacion', '') != 'aprobada'
        && request.resource.data.get('estatusJustificacion', '') ==
          'pendiente_revision'
        && request.resource.data.get('motivoFalta', '') is string
        && request.resource.data.get('motivoFalta', '').size() > 0
        && request.resource.data.get('motivoFalta', '').size() <= 2000
        && request.resource.data.get('evidenciaJustificacionUrl', '') is string
        && request.resource.data.get('evidenciaJustificacionUrl', '').size() <= 4096
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'motivoFalta',
          'evidenciaJustificacionUrl',
          'estatusJustificacion'
        ]);
    }

    function updatesOwnAttendanceNotes() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'observacionesTrabajador'
      ])
        && request.resource.data.observacionesTrabajador is string
        && request.resource.data.observacionesTrabajador.size() <= 2000;
    }

    function assignedToProject(projectId) {
      let project = get(/databases/$(database)/documents/proyectos/$(projectId));
      return isAdmin()
        || (project.data.encargados is list
          && request.auth.uid in project.data.encargados);
    }

    function assignedToActivity(activityId) {
      let activity = get(/databases/$(database)/documents/actividades/$(activityId));
      return isAdmin()
        || activity.data.asignadoATrabajadorId == request.auth.uid;
    }

    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || isSafeOwnProfileUpdate(userId);
      allow delete: if isAdmin();

      match /sugerencias/{suggestionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.autorId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.autorId == request.auth.uid)
          || (signedIn() && userId == request.auth.uid);
      }
    }

    // Información comercial y financiera: exclusivamente administración.
    match /clientes/{documentId} {
      allow read, write: if isAdmin();
    }
    match /seguimiento_cotizaciones/{documentId} {
      allow read, write: if isAdmin();
    }
    match /proveedores/{documentId} {
      allow read, write: if isAdmin();
    }
    match /compras/{documentId} {
      allow read, write: if isAdmin();
    }
    match /compras_insumos/{documentId} {
      allow read, write: if isAdmin();
    }
    match /ideas_lineas_negocio/{documentId} {
      allow read, write: if isAdmin();
    }

    match /proyectos/{projectId} {
      allow read: if signedIn()
        && (isAdmin()
          || (resource.data.encargados is list
            && request.auth.uid in resource.data.encargados));
      allow create, update, delete: if isAdmin();

      match /finanzas/{documentId} {
        allow read, write: if isAdmin();
      }

      match /conversacion/{messageId} {
        allow read: if signedIn() && assignedToProject(projectId);
        allow create: if signedIn()
          && assignedToProject(projectId)
          && request.resource.data.autorId == request.auth.uid;
        allow update: if signedIn()
          && assignedToProject(projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesPor'
          ]);
        allow delete: if isAdmin()
          || (signedIn() && resource.data.autorId == request.auth.uid);
      }
    }

    // Registro inmutable de las salidas a instalación. La hora siempre la
    // impone Firestore y solo puede registrar un integrante del proyecto.
    match /salidas_instalacion/{checkInId} {
      allow read: if signedIn()
        && (isAdmin()
          || resource.data.usuarioId == request.auth.uid
          || assignedToProject(resource.data.proyectoId));
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'proyectoId',
          'proyectoTitulo',
          'usuarioId',
          'usuarioNombre',
          'fecha',
          'ubicacionRegistrada',
          'origen'
        ])
        && request.resource.data.keys().hasOnly([
          'proyectoId',
          'proyectoTitulo',
          'usuarioId',
          'usuarioNombre',
          'fecha',
          'ubicacionRegistrada',
          'ubicacion',
          'precisionMetros',
          'origen'
        ])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.proyectoId is string
        && assignedToProject(request.resource.data.proyectoId)
        && request.resource.data.proyectoTitulo ==
          get(/databases/$(database)/documents/proyectos/$(request.resource.data.proyectoId)).data.titulo
        && request.resource.data.usuarioNombre == get(userPath()).data.nombre
        && request.resource.data.fecha == request.time
        && request.resource.data.origen == 'proyecto'
        && request.resource.data.ubicacionRegistrada is bool
        && (request.resource.data.ubicacionRegistrada
          ? (request.resource.data.keys().hasAll([
              'ubicacion',
              'precisionMetros'
            ])
            && request.resource.data.ubicacion is latlng
            && request.resource.data.precisionMetros is number
            && request.resource.data.precisionMetros >= 0
            && request.resource.data.precisionMetros <= 10000)
          : !request.resource.data.keys().hasAny([
              'ubicacion',
              'precisionMetros'
            ]));
      allow update: if false;
      allow delete: if isAdmin();
    }

    function projectMaster(projectId) {
      return signedIn() && role() == 'maestro'
        && projectId is string && assignedToProject(projectId);
    }
    function validMasterTask() {
      let d = request.resource.data;
      let project = get(/databases/$(database)/documents/proyectos/$(d.proyectoId)).data;
      return projectMaster(d.proyectoId)
        && d.keys().hasOnly(['proyectoId','titulo','descripcion','asignadoATrabajadorId','fechaInicio','fechaTermino','fechaAsignada','completadoEn','estatus','observacionesAdmin','comentariosTrabajador','evidenciaFotos','historialEventos','evidenciasCount','cantidadEvidencias','ultimoAvance','requiereEvidencia','creadoPor','creadoEn'])
        && d.creadoPor == request.auth.uid && d.creadoEn == request.time
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 250
        && d.descripcion is string && d.descripcion.size() <= 5000
        && d.asignadoATrabajadorId is string && d.asignadoATrabajadorId in project.encargados
        && d.fechaInicio is timestamp && d.fechaAsignada is timestamp && d.fechaTermino is timestamp
        && d.fechaTermino > d.fechaInicio && d.estatus == 'pendiente'
        && d.requiereEvidencia == true && d.evidenciasCount == 0 && d.cantidadEvidencias == 0
        && d.evidenciaFotos == [] && d.historialEventos == []
        && d.completadoEn == null && d.ultimoAvance == null
        && d.observacionesAdmin == '' && d.comentariosTrabajador == '';
    }
    function editsOwnMasterTask() {
      let d = request.resource.data;
      return projectMaster(resource.data.proyectoId)
        && resource.data.get('creadoPor', '') == request.auth.uid
        && resource.data.estatus != 'completado'
        && d.diff(resource.data).affectedKeys().hasOnly(['titulo','descripcion','asignadoATrabajadorId','fechaTermino','fechaAsignada'])
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 250
        && d.descripcion is string && d.descripcion.size() <= 5000
        && d.asignadoATrabajadorId in get(/databases/$(database)/documents/proyectos/$(resource.data.proyectoId)).data.encargados
        && d.fechaTermino is timestamp && d.fechaTermino > resource.data.fechaInicio;
    }

    match /actividades/{activityId} {
      // Allows transactional creation, not reads of another project's existing task.
      allow get: if signedIn() && (isAdmin() || role() == 'maestro')
        && !exists(/databases/$(database)/documents/actividades/$(activityId));
      allow read: if signedIn()
        && (isAdmin()
          || resource.data.asignadoATrabajadorId == request.auth.uid
          || assignedToProject(resource.data.proyectoId));
      allow create: if isAdmin() || validMasterTask();
      allow delete: if isAdmin();
      allow update: if isAdmin() || editsOwnMasterTask()
        || (signedIn()
          && resource.data.asignadoATrabajadorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estatus',
            'iniciadoEn',
            'completadoEn',
            'ultimoAvance',
            'comentariosTrabajador',
            'evidenciasCount',
            'cantidadEvidencias'
          ]));

      match /evidencias/{evidenceId} {
        allow read, write: if signedIn() && assignedToActivity(activityId);
      }
      match /avances/{progressId} {
        allow read, write: if signedIn() && assignedToActivity(activityId);
      }
    }

    // Historias y notas internas: solo el equipo autenticado puede verlas.
    // La vigencia se fija al crear y no puede extenderse después.
    match /historias_sociales/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'autorId',
          'autorNombre',
          'autorFotoUrl',
          'autorRol',
          'texto',
          'imagenUrl',
          'imagenRuta',
          'creadaEn',
          'expiraEn'
        ])
        && request.resource.data.keys().hasOnly([
          'autorId',
          'autorNombre',
          'autorFotoUrl',
          'autorRol',
          'texto',
          'imagenUrl',
          'imagenRuta',
          'creadaEn',
          'expiraEn'
        ])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.autorNombre == get(userPath()).data.nombre
        && request.resource.data.autorRol == role()
        && request.resource.data.autorFotoUrl is string
        && request.resource.data.autorFotoUrl.size() <= 2048
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 400
        && request.resource.data.imagenUrl is string
        && request.resource.data.imagenUrl.size() <= 4096
        && request.resource.data.imagenRuta is string
        && request.resource.data.imagenRuta.size() <= 512
        && ((request.resource.data.imagenUrl.size() == 0
              && request.resource.data.imagenRuta.size() == 0)
          || (request.resource.data.imagenUrl.size() > 0
              && request.resource.data.imagenRuta.matches(
                'media/' + request.auth.uid + '/.*'
              )))
        && (request.resource.data.texto.size() > 0
          || request.resource.data.imagenUrl.size() > 0)
        && request.resource.data.creadaEn == request.time
        && request.resource.data.expiraEn is timestamp
        && request.resource.data.expiraEn >
          request.time + duration.value(23, 'h')
        && request.resource.data.expiraEn <
          request.time + duration.value(25, 'h');
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.autorId == request.auth.uid);
    }

    match /publicaciones_sociales/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.autorId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.autorId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesPor',
            'comentariosCount'
          ]));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.autorId == request.auth.uid);

      match /comentarios/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.autorId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.autorId == request.auth.uid);
      }
    }

    match /seguimientos/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.seguidorId == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.seguidorId == request.auth.uid);
    }

    match /conversaciones/{conversationId} {
      allow read: if signedIn()
        && resource.data.participantes is list
        && request.auth.uid in resource.data.participantes;
      allow create: if signedIn()
        && request.resource.data.participantes is list
        && request.auth.uid in request.resource.data.participantes
        && request.resource.data.participantes.size() == 2;
      allow update: if signedIn()
        && resource.data.participantes is list
        && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes;
      allow delete: if isAdmin();

      match /mensajes/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(conversationId)).data.participantes;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(conversationId)).data.participantes
          && request.resource.data.autorId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.autorId == request.auth.uid);
      }
    }

    function notificationVisible(data) {
      return signedIn() && (data.get('destinatarioId', '') == request.auth.uid
        || data.get('destinatarioId', '') == 'todos'
        || data.get('rolesDestinatarios', []).hasAny([role(), 'todos']));
    }

    match /notificaciones/{notificationId} {
      allow read: if notificationVisible(resource.data);
      allow create: if isAdmin() || isSafeNotificationCreate();
      allow update: if notificationVisible(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'leidosPor'
        ])
        && resource.data.leidosPor is list
        && request.resource.data.leidosPor is list
        && request.resource.data.leidosPor.hasAll(resource.data.leidosPor)
        && request.auth.uid in request.resource.data.leidosPor
        && request.resource.data.leidosPor.size() <= resource.data.leidosPor.size() + 1;
      allow delete: if isAdmin();
    }

    match /asistencias/{attendanceId} {
      // A missing own day can be read transactionally without exposing another person's record.
      allow get: if signedIn()
        && !exists(/databases/$(database)/documents/asistencias/$(attendanceId))
        && attendanceId.matches(request.auth.uid + '_[0-9]{8}');
      allow read: if isAdmin()
        || (signedIn() && resource.data.trabajadorId == request.auth.uid);
      allow create: if isAdmin() || isValidAttendanceCreate(attendanceId);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.trabajadorId == request.auth.uid
          && request.resource.data.trabajadorId == resource.data.trabajadorId
          && (submitsOwnJustification()
            || updatesOwnAttendanceNotes()));
      allow delete: if isAdmin();
    }

    match /mensajes_audio/{messageId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.emisorId == request.auth.uid);
    }

    // Operación interna de almacén. Los trabajadores pueden solicitar y
    // consultar; administración y almacén mantienen inventario y entregas.
    function initialToolRequest() {
      let d = request.resource.data;
      return signedIn() && (isWarehouse() || d.trabajadorId == request.auth.uid)
        && d.keys().hasOnly(['proyectoId','proyectoNombre','trabajadorId','trabajadorNombre','insumoId','nombreInsumo','cantidad','esRetornable','estatus','marcadoDevueltoTrabajador','devueltoConfirmadoAdmin','fechaSolicitud','fechaAprobacion','fechaLimiteDevolucion','tieneReporteFalla','observacionesDevolucion','fotoDevolucionUrl','fechaMarcadoDevuelto','notaAdmin','requiereCompra'])
        && d.insumoId is string && d.insumoId.size() > 0 && d.cantidad is int && d.cantidad > 0 && d.cantidad <= 100000
        && d.esRetornable is bool && d.estatus == 'pendiente'
        && d.marcadoDevueltoTrabajador == false && d.devueltoConfirmadoAdmin == false
        && d.tieneReporteFalla == false && d.get('fechaAprobacion',null) == null
        && d.get('fechaMarcadoDevuelto',null) == null && d.fechaSolicitud is timestamp;
    }
    function workerToolReport() {
      let d = request.resource.data;
      let old = resource.data;
      return signedIn() && old.trabajadorId == request.auth.uid && (
        (old.estatus == 'pendiente' && d.diff(old).affectedKeys().hasOnly(['cantidad','esRetornable'])
          && d.cantidad is int && d.cantidad > 0 && d.cantidad <= 100000 && d.esRetornable is bool)
        || (old.estatus == 'pendiente' && d.diff(old).affectedKeys().hasOnly(['estatus','canceladoPor','fechaCancelacion'])
          && d.estatus == 'cancelada' && d.canceladoPor == request.auth.uid && d.fechaCancelacion == request.time)
        || (old.estatus == 'aprobada' && old.esRetornable == true && old.devueltoConfirmadoAdmin == false
          && d.diff(old).affectedKeys().hasOnly(['marcadoDevueltoTrabajador','tieneReporteFalla','observacionesDevolucion','fotoDevolucionUrl','fechaMarcadoDevuelto'])
          && d.marcadoDevueltoTrabajador == true && d.tieneReporteFalla is bool
          && d.get('observacionesDevolucion','') is string && d.observacionesDevolucion.size() <= 2000
          && (d.get('fotoDevolucionUrl',null) == null || (d.fotoDevolucionUrl is string && d.fotoDevolucionUrl.size() <= 4096))
          && d.fechaMarcadoDevuelto == request.time));
    }
    function linkedWarehouseEvent(id, action) {
      let path = /databases/$(database)/documents/solicitudes_herramientas/$(id)/historial/$(action);
      let event = getAfter(path).data;
      return !exists(path) && event.accion == action && event.solicitudId == id
        && event.responsableId == request.auth.uid && event.fecha == request.time
        && event.cantidad == resource.data.cantidad && event.trabajadorId == resource.data.trabajadorId
        && event.insumoId == resource.data.insumoId;
    }
    function warehouseApproval(id) {
      let d = request.resource.data;
      let old = resource.data;
      let item = /databases/$(database)/documents/insumos_inventario/$(old.insumoId);
      return isWarehouse() && old.cantidad is int && old.cantidad > 0 && (
        (old.estatus == 'pendiente' && d.estatus == 'rechazada'
          && d.diff(old).affectedKeys().hasOnly(['estatus','rechazadoPor','fechaRechazo','notaAdmin'])
          && d.rechazadoPor == request.auth.uid && d.fechaRechazo == request.time && linkedWarehouseEvent(id,'rechazo'))
        || (old.estatus == 'pendiente' && d.estatus == 'aprobada'
          && d.diff(old).affectedKeys().hasOnly(['estatus','fechaAprobacion','autorizadoPorAdminId','notaAdmin','fechaLimiteDevolucion'])
          && d.autorizadoPorAdminId == request.auth.uid && d.fechaAprobacion == request.time
          && get(item).data.cantidad_disponible >= old.cantidad
          && getAfter(item).data.cantidad_disponible == get(item).data.cantidad_disponible - old.cantidad
          && linkedWarehouseEvent(id,'salida'))
        || (old.estatus == 'aprobada' && old.esRetornable == true && old.devueltoConfirmadoAdmin == false
          && d.diff(old).affectedKeys().hasOnly(['devueltoConfirmadoAdmin','recibidoPor','fechaRecepcion'])
          && d.devueltoConfirmadoAdmin == true && d.recibidoPor == request.auth.uid && d.fechaRecepcion == request.time
          && (old.get('tieneReporteFalla',false) == true
            ? getAfter(item).data.en_reparacion == get(item).data.get('en_reparacion',0) + old.cantidad
              && getAfter(item).data.cantidad_disponible == get(item).data.cantidad_disponible
            : getAfter(item).data.cantidad_disponible == get(item).data.cantidad_disponible + old.cantidad)
          && linkedWarehouseEvent(id,'entrada')));
    }
    match /solicitudes_herramientas/{documentId} {
      allow read: if signedIn();
      allow create: if initialToolRequest();
      allow update: if workerToolReport() || warehouseApproval(documentId);
      // Requests and confirmed movements are retained, including cancellations.
      allow delete: if false;
      match /historial/{eventId} {
        allow read: if isWarehouse() || (signedIn()
          && get(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.trabajadorId == request.auth.uid);
        allow create: if isWarehouse() && eventId in ['salida','rechazo','entrada']
          && request.resource.data.keys().hasOnly(['accion','solicitudId','insumoId','cantidad','responsableId','responsableNombre','trabajadorId','fecha','observacion','conFalla'])
          && request.resource.data.accion == eventId && request.resource.data.solicitudId == documentId
          && request.resource.data.responsableId == request.auth.uid && request.resource.data.fecha == request.time
          && request.resource.data.cantidad == getAfter(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.cantidad
          && (eventId == 'salida'
            ? get(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.estatus == 'pendiente' && getAfter(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.estatus == 'aprobada'
            : eventId == 'rechazo'
              ? get(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.estatus == 'pendiente' && getAfter(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.estatus == 'rechazada'
              : get(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.devueltoConfirmadoAdmin == false && getAfter(/databases/$(database)/documents/solicitudes_herramientas/$(documentId)).data.devueltoConfirmadoAdmin == true);
        allow update, delete: if false;
      }
    }
    match /solicitudes_salida/{documentId} {
      allow read, create, update: if signedIn();
      allow delete: if isWarehouse();
    }
    match /insumos_inventario/{documentId} {
      allow read: if signedIn();
      allow write: if isWarehouse();
    }
    match /categorias_inventario/{documentId} {
      allow read: if signedIn();
      allow write: if isWarehouse();
    }
    match /subcategorias_inventario/{documentId} {
      allow read: if signedIn();
      allow write: if isWarehouse();
    }
    match /cajitas_inventario/{documentId} {
      allow read: if signedIn();
      allow create, delete: if isWarehouse();
      allow update: if isWarehouse()
        || isValidWorkerToolUpdate(documentId);
    }
    match /traspasos_inventario/{documentId} {
      allow read: if isWarehouse();
      allow read: if signedIn()
        && request.auth.uid in resource.data.get('participantes', []);
      allow read: if signedIn()
        && (resource.data.get('origen_usuario_id', '') == request.auth.uid
          || resource.data.get('destino_usuario_id', '') == request.auth.uid);
      allow create: if isWarehouse() || createsValidToolTransfer(documentId);
      allow update: if isWarehouse() || resolvesOwnToolTransfer(documentId);
      allow delete: if isWarehouse();
    }
    match /reparaciones_taller/{documentId} {
      allow read: if signedIn();
      allow write: if isWarehouse();
    }
    match /historial_recepciones/{documentId} {
      allow read: if signedIn();
      allow write: if isWarehouse();
    }
    match /cat_saunas/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    function gameWin(b,m) {
      return (b[0] == m && b[1] == m && b[2] == m) || (b[3] == m && b[4] == m && b[5] == m) || (b[6] == m && b[7] == m && b[8] == m) || (b[0] == m && b[3] == m && b[6] == m) || (b[1] == m && b[4] == m && b[7] == m) || (b[2] == m && b[5] == m && b[8] == m) || (b[0] == m && b[4] == m && b[8] == m) || (b[2] == m && b[4] == m && b[6] == m);
    }
    function gameResult(b) {
      return gameWin(b,'X') ? 'X' : gameWin(b,'O') ? 'O' : b.hasAny(['']) ? '' : 'empate';
    }
    function oneGameMove(old,b,m) {
      let i = b[0] != old[0] ? 0 : b[1] != old[1] ? 1 : b[2] != old[2] ? 2 : b[3] != old[3] ? 3 : b[4] != old[4] ? 4 : b[5] != old[5] ? 5 : b[6] != old[6] ? 6 : b[7] != old[7] ? 7 : b[8] != old[8] ? 8 : -1;
      return b is list && b.size() == 9 && i >= 0 && old[i] == '' && b[i] == m
        && (i == 0 || b[0] == old[0]) && (i == 1 || b[1] == old[1]) && (i == 2 || b[2] == old[2])
        && (i == 3 || b[3] == old[3]) && (i == 4 || b[4] == old[4]) && (i == 5 || b[5] == old[5])
        && (i == 6 || b[6] == old[6]) && (i == 7 || b[7] == old[7]) && (i == 8 || b[8] == old[8]);
    }
    match /partidas_equipo/{gameId} {
      allow get: if signedIn() && gameId.matches('juego_' + request.auth.uid + '_[A-Za-z0-9]+')
        && !exists(/databases/$(database)/documents/partidas_equipo/$(gameId));
      allow read: if signedIn() && request.auth.uid in resource.data.jugadores;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['jugadores','nombres','tablero','estado','turno','resultado','creadoPor','fecha','actualizadaEn'])
        && request.resource.data.jugadores is list && request.resource.data.jugadores.size() == 2
        && request.resource.data.jugadores[0] == request.auth.uid && request.resource.data.jugadores[1] is string
        && request.resource.data.jugadores[1] != request.auth.uid
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.jugadores[1]))
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.jugadores[1])).data.get('activo',true) != false
        && request.resource.data.nombres is list && request.resource.data.nombres.size() == 2
        && request.resource.data.tablero == ['','','','','','','','','']
        && request.resource.data.estado == 'invitada' && request.resource.data.turno == request.auth.uid
        && request.resource.data.resultado == '' && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.fecha == request.time && request.resource.data.actualizadaEn == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.jugadores
        && request.resource.data.actualizadaEn == request.time && (
        (resource.data.estado == 'invitada' && request.auth.uid == resource.data.jugadores[1]
          && request.resource.data.estado == 'jugando'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadaEn']))
        || (resource.data.estado in ['invitada','jugando'] && request.resource.data.estado == 'cancelada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadaEn']))
        || (resource.data.estado == 'jugando' && resource.data.turno == request.auth.uid
          && resource.data.resultado == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tablero','turno','resultado','estado','actualizadaEn'])
          && oneGameMove(resource.data.tablero,request.resource.data.tablero,request.auth.uid == resource.data.jugadores[0] ? 'X' : 'O')
          && request.resource.data.turno == (request.auth.uid == resource.data.jugadores[0] ? resource.data.jugadores[1] : resource.data.jugadores[0])
          && request.resource.data.resultado == gameResult(request.resource.data.tablero)
          && request.resource.data.estado == (request.resource.data.resultado == '' ? 'jugando' : 'terminada')));
      allow delete: if false;
    }

    // Legacy admin access does not bypass immutable movement history or game turns.
    match /{rootCollection}/{document=**} {
      allow read, write: if isAdmin() && !(rootCollection in ['solicitudes_herramientas','partidas_equipo']);
    }
  }
}
